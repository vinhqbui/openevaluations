+def _spread(amount: int, weights: list[int]) -> list[int]:
+    """``amount`` split in proportion to ``weights``: floors, then the cents left over one each to
+    the largest remainders (the earlier one on a tie). The parts add up exactly to ``amount``."""
+    whole = sum(weights)
+    if not whole:
+        return [0] * len(weights)
+    parts = [amount * w // whole for w in weights]
+    rems = [amount * w % whole for w in weights]
+    order = sorted(range(len(weights)), key=lambda i: (-rems[i], i))
+    for i in order[: amount - sum(parts)]:
+        parts[i] += 1
+    return parts
+
