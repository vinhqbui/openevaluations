+        """Every id in ``collection``, sorted."""
+
+    @abstractmethod
+    def _records(self, collection: str, ids: list[str]) -> list[dict]:
+        """The records with ``ids``, in that order, as the caller's own copies."""
+
     def list_page(self, collection: str, cursor: str | None = None, limit: int = 50) -> Page:
         """Records in id order, starting after ``cursor``, at most ``min(limit, max_page_size)``."""
+        keys = self._ids(collection)
+        start = bisect.bisect_right(keys, cursor) if cursor is not None else 0
+        size = max(1, min(limit, self.max_page_size))
+        chunk = keys[start : start + size]
+        more = start + size < len(keys)
+        return Page(self._records(collection, chunk), chunk[-1] if more and chunk else None)
 
