{
  // Static site for openevaluations.si: serves site/ as is, no Worker code.
  "name": "openevaluations",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // Cloudflare's Git integration runs `wrangler preview` for non-production branches; it needs
  // this block, even empty.
  "previews": {},
  // The root of openevaluations.si is this Worker's custom domain; www is redirected to the root by
  // a zone rule. The product site (Margincode, formerly Scholion) is at open.margincode.dev.
  "routes": [
    { "pattern": "openevaluations.si", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
